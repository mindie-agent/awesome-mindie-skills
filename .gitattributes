# Enforce Unix LF (\n) line endings across native Windows, WSL, macOS, and Linux.
# Windows CRLF (\r\n) is strictly prohibited in all text files; retain Git's binary-file detection.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.ps1 text eol=lf
*.cmd text eol=lf
*.bat text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
